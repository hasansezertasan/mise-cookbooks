root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,json5}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{htm,html,js,ts,tsx,css,sass,scss,less,svg,vue}]
indent_size = 2

[*.{xml,config}]
indent_size = 2

[*.{cmd,bat}]
end_of_line = crlf

[*.sh]
end_of_line = lf
# <<< cobo:end sha256=e77e873fad9f0ff5e000743b383685dae54dc35063610f628ff909e1de72e8bd <<<

# Project-specific overrides (later sections win over the cobo block above).
[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf

[*.{yml,yaml}]
indent_size = 2
max_line_length = 120

[*.toml]
indent_size = 2

[**]
ignore = .git, .vscode, .DS_Store

# cobo-managed files that are not source: cobo.lock is rendered with 2-space TOML
# tables, and .gitignore keeps the lone CR bytes of the macOS patterns.
[cobo.lock]
indent_size = 2

[.gitignore]
end_of_line = unset
